# Copiez ce fichier en .env, dans ce meme dossier backend/. Aucun secret ici :
# seulement le choix des moteurs.

# Sans carte graphique NVIDIA : moteurs de demonstration. Tout l'onboarding
# fonctionne, mais la synthese rend un audio silencieux.
TTS_ENGINE=fake
STT_ENGINE=fake

# Avec un GPU NVIDIA, supprimez les deux lignes ci-dessus : les valeurs par
# defaut sont celles de production (chatterbox_mtl en francais, et kyutai).
# DATA_DIR=data
# OLLAMA_URL=http://127.0.0.1:11434

# Carte AMD (Ollama l'exploite via Vulkan) ou pas de CUDA : supprimez aussi les
# lignes fake, imposez le modele de langage et faites tourner la voix et la
# transcription sur le processeur (plus lent : 20 a 40 s par phrase).
# LLM_MODEL=qwen3:8b-q4_K_M
# TORCH_DEVICE=cpu
