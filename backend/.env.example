# Copiez ce fichier en .env, dans ce meme dossier backend/. Aucun secret ici :
# seulement le choix des moteurs.

# Sans carte graphique NVIDIA : moteurs de demonstration. Tout l'onboarding
# fonctionne, mais la synthese rend un audio silencieux.
TTS_ENGINE=fake
STT_ENGINE=fake

# Avec un GPU, supprimez les deux lignes ci-dessus : les valeurs par defaut
# sont celles de production (chatterbox et kyutai).
# DATA_DIR=data
# OLLAMA_URL=http://127.0.0.1:11434
